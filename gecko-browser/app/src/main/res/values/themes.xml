<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.horiZen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- The Android 12+ system splash owns the first frame: the mark on the
         night field, then the activity hands over to the animated Compose
         splash (see ui/Splash.kt). -->
    <style name="Theme.horiZen.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/horizen_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">320</item>
        <item name="postSplashScreenTheme">@style/Theme.horiZen</item>
    </style>
</resources>
