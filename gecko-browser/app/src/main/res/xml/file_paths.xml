<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Downloads saved by the app on API < 29. -->
    <external-files-path
        name="downloads"
        path="Download/" />
    <files-path
        name="internal_downloads"
        path="Downloads/" />
    <!-- In-flight and finished files written by DownloadService. -->
    <files-path
        name="app_downloads"
        path="downloads/" />
    <!-- OTA updates downloaded at runtime; needed to hand a FileProvider URI
         to the system package installer. -->
    <files-path
        name="updates"
        path="updates/" />
</paths>
